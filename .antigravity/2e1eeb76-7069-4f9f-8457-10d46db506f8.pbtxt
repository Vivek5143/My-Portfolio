      arguments_json: "{\"Instruction\":\"Add fonts and theme to index.css.\",\"ReplacementContent\":\"@import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap\');\\n@import \\\"tailwindcss\\\";\\n\\n@theme {\\n  --font-sans: \\\"Inter\\\", ui-sans-serif, system-ui, sans-serif;\\n  --font-mono: \\\"JetBrains Mono\\\", ui-monospace, SFMono-Regular, monospace;\\n  \\n  --color-cyber-black: #050505;\\n  --color-cyber-gray: #111111;\\n  --color-cyber-accent: #00ff9d; /* Neon Green/Cyan */\\n  --color-cyber-text: #e0e0e0;\\n}\\n\\n@layer base {\\n  body {\\n    @apply bg-cyber-black text-cyber-text font-sans antialiased selection:bg-cyber-accent selection:text-cyber-black;\\n  }\\n}\\n\\n.glass-card {\\n  @apply bg-cyber-gray/50 border border-white/10 backdrop-blur-md rounded-2xl;\\n}\\n\\n.text-gradient {\\n  @apply bg-clip-text text-transparent bg-gradient-to-r from-cyber-accent to-blue-400;\\n}\",\"TargetContent\":\"@import \\\"tailwindcss\\\";\",\"TargetFile\":\"/src/index.css\"}"
    }
    tool_calls {
      id: "443bnlu1"
      name: "create_file"
      arguments_json: "{\"Content\":\"export interface Project {\\n  title: string;\\n  description: string;\\n  technologies: string[];\\n  highlights: string[];\\n  link?: string;\\n}\\n\\nexport interface Experience {\\n  company: string;\\n  role: string;\\n  period: string;\\n  location: string;\\n  highlights: string[];\\n}\\n\\nexport interface SkillCategory {\\n  title: string;\\n  skills: string[];\\n}\\n\",\"Overwrite\":true,\"TargetFile\":\"/src/types.ts\"}"
    }
    tool_calls {
      id: "34kcdcpi"
      name: "create_file"
      arguments_json: "{\"Content\":\"import { Project, Experience, SkillCategory } from \'./types\';\\n\\nexport const PROJECTS: Project[] = [\\n  {\\n    title: \\\"CampusPal\\\",\\n    description: \\\"Agentic AI Chatbot with RAG for college-related queries.\\\",\\n    technologies: [\\\"Python\\\", \\\"FastAPI\\\", \\\"LangChain\\\", \\\"Llama 3 70B\\\", \\\"FAISS\\\", \\\"React.js\\\"],\\n    highlights: [\\n      \\\"Hybrid ReAct Agent routing between local RAG and real-time web search.\\\",\\n      \\\"5-layer hallucination defense system with strict prompt engineering.\\\",\\n      \\\"Optimized FAISS retrieval (k=5) for context-aware responses.\\\"\\n    ]\\n  },\\n  {\\n    title: \\\"EduDiff\\\",\\n    description: \\\"AI-Powered Math Animation Generator converting prompts to video.\\\",\\n    technologies: [\\\"Python\\\", \\\"Flask\\\", \\\"Next.js\\\", \\\"Gemini 2.5 Flash\\\", \\\"Manim\\\", \\\"Docker\\\"],\\n    highlights: [\\n      \\\"Full-stack Generative AI application using Gemini 2.5 Flash for code generation.\\\",\\n      \\\"REST API pipeline handling end-to-end prompt-to-video workflows.\\\",\\n      \\\"Containerized deployment using Docker Compose.\\\"\\n    ]\\n  },\\n  {\\n    title: \\\"TransactAI\\\",\\n    description: \\\"Hybrid Transaction Categorizer built for production scalability.\\\",\\n    technologies: [\\\"Python\\\", \\\"FastAPI\\\", \\\"DistilBERT\\\", \\\"scikit-learn\\\", \\\"NumPy\\\", \\\"Pandas\\\"],\\n    highlights: [\\n      \\\"Transformer-based NLP model for intelligent transaction classification.\\\",\\n      \\\"Robust data preprocessing pipelines with secure input handling.\\\",\\n      \\\"Focus on scalability, input validation, and secure API design.\\\"\\n    ]\\n  }\\n];\\n\\nexport const EXPERIENCES: Experience[] = [\\n  {\\n    company: \\\"DSW | Data Science Wizards\\\",\\n    role: \\\"Data Science Engineer Intern\\\",\\n    period: \\\"Aug 2025 \342\200\223 Feb 2026\\\",\\n    location: \\\"Thane, India\\\",\\n    highlights: [\\n      \\\"Contributed to a production-grade observability platform for real client environments.\\\",\\n      \\\"Implemented a PII detection and encryption pipeline using Microsoft Presidio.\\\",\\n      \\\"Collaborated on backend improvements and technical documentation.\\\"\\n    ]\\n  }\\n];\\n\\nexport const SKILLS: SkillCategory[] = [\\n  {\\n    title: \\\"Languages\\\",\\n    skills: [\\\"Python\\\", \\\"Java\\\", \\\"C++\\\", \\\"JavaScript\\\"]\\n  },\\n  {\\n    title: \\\"AI/LLM Stack\\\",\\n    skills: [\\\"LangChain\\\", \\\"RAG\\\", \\\"Agentic AI\\\", \\\"Gemini API\\\", \\\"OpenAI\\\", \\\"Llama 3\\\", \\\"TensorFlow\\\"]\\n  },\\n  {\\n    title: \\\"Dev Tools\\\",\\n    skills: [\\\"Docker\\\", \\\"K8s\\\", \\\"FastAPI\\\", \\\"React.js\\\", \\\"ClickHouse\\\", \\\"Git\\\", \\\"PostgreSQL\\\"]\\n  }\\n];\\n\",\"Overwrite\":true,\"TargetFile\":\"/src/constants.ts\"}"
