  file_change {
    absolute_path_uri: "file:///src/index.css"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "@import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n  \n  --color-cyber-black: #050505;\n  --color-cyber-gray: #111111;\n  --color-cyber-accent: #00ff9d; /* Neon Green/Cyan */\n  --color-cyber-text: #e0e0e0;\n}\n\n@layer base {\n  body {\n    @apply bg-cyber-black text-cyber-text font-sans antialiased selection:bg-cyber-accent selection:text-cyber-black;\n  }\n}\n\n.glass-card {\n  @apply bg-cyber-gray/50 border border-white/10 backdrop-blur-md rounded-2xl;\n}\n\n.text-gradient {\n  @apply bg-clip-text text-transparent bg-gradient-to-r from-cyber-accent to-blue-400;\n}"
      replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Sora:wght@400;600;700;800&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Sora\", \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n  \n  --color-cyber-bg: #050816;\n  --color-cyber-accent: #7C3AED; /* Purple */\n  --color-cyber-blue: #3B82F6; /* Blue */\n  --color-cyber-emerald: #10B981; /* Emerald */\n  --color-glass-bg: rgba(10, 15, 35, 0.45);\n}\n\n@layer base {\n  body {\n    background-color: var(--color-cyber-bg);\n    color: #e2e8f0;\n    font-family: var(--font-sans);\n    overflow-x: hidden;\n  }\n}\n\n/* Custom Grid & Glow Effects */\n.grid-bg {\n  background-image: \n    radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.05) 1px, transparent 0),\n    linear-gradient(to bottom, #050816, #090c24);\n  background-size: 40px 40px, 100% 100%;\n}\n\n.glass-card {\n  background: rgba(10, 15, 35, 0.45);\n  border: 1px solid rgba(255, 255, 255, 0.07);\n  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n}\n\n.glass-card-hover {\n  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n}\n.glass-card-hover:hover {\n  transform: translateY(-4px) scale(1.01);\n  border-color: rgba(124, 58, 237, 0.3);\n  box-shadow: 0 12px 40px rgba(124, 58, 237, 0.15);\n}\n\n.text-gradient-purple {\n  background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.text-gradient-blue {\n  background: linear-gradient(135deg, #60a5fa 0%, #2563eb 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.text-gradient-emerald {\n  background: linear-gradient(135deg, #34d399 0%, #059669 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.text-gradient-rainbow {\n  background: linear-gradient(135deg, #7c3aed 0%, #3b82f6 50%, #10b981 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n}\n::-webkit-scrollbar-track {\n  background: #050816;\n}\n::-webkit-scrollbar-thumb {\n  background: rgba(255, 255, 255, 0.1);\n  border-radius: 9999px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: rgba(124, 58, 237, 0.4);\n}\n\n/* Custom glow element */\n.radial-glow {\n  background: radial-gradient(circle, rgba(124, 58, 237, 0.08) 0%, transparent 70%);\n}\n\n.waveform-bar {\n  animation: wave 1.2s ease-in-out infinite alternate;\n}\n\n@keyframes wave {\n  0% { transform: scaleY(0.3); }\n  100% { transform: scaleY(1); }\n}"
    }
