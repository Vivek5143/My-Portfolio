    replacement_infos {
      original_chunk {
        target_content: "            {SKILLS.map((category, idx) => (\n              <motion.div \n                key={category.title}\n                initial={{ opacity: 0, scale: 0.96 }}\n                whileInView={{ opacity: 1, scale: 1 }}\n                viewport={{ once: true }}\n                transition={{ duration: 0.5, delay: idx * 0.1 }}\n                className=\"glass-card glass-card-hover p-6 flex flex-col justify-between\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between border-b border-white/5 pb-4 mb-6\">\n                    <h3 className=\"text-[#a78bfa] font-mono text-xs uppercase tracking-widest\">{category.title}</h3>\n                    <code className=\"text-[10px] text-gray-600 font-mono\">v1.26</code>\n                  </div>\n                  \n                  <div className=\"flex flex-wrap gap-2.5\">\n                    {category.skills.map((skill, sIdx) => (\n                      <span \n                        key={skill} \n                        className=\"px-3.5 py-1.5 bg-white/5 border border-white/10 rounded-xl text-xs font-mono text-gray-300 hover:text-white hover:bg-white/10 hover:border-[#7C3AED]/40 transition-colors duration-200\"\n                      >\n                        {skill}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n                \n                <div className=\"mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-gray-500\">\n                  <span>Stack Coverage</span>\n                  <span className=\"text-[#10B981]\">Production Certified</span>\n                </div>\n              </motion.div>\n            ))}"
        replacement_content: "            {SKILLS.map((category, idx) => (\n              <SpotlightCard \n                key={category.title}\n                initial={{ opacity: 0, scale: 0.96 }}\n                whileInView={{ opacity: 1, scale: 1 }}\n                viewport={{ once: true }}\n                transition={{ duration: 0.5, delay: idx * 0.1 }}\n                glowColor={\n                  idx % 3 === 0 \n                    ? \"rgba(16, 185, 129, 0.1)\" \n                    : idx % 3 === 1 \n                    ? \"rgba(124, 58, 237, 0.1)\" \n                    : \"rgba(59, 130, 246, 0.1)\"\n                }\n                borderColor={\n                  idx % 3 === 0 \n                    ? \"rgba(16, 185, 129, 0.25)\" \n                    : idx % 3 === 1 \n                    ? \"rgba(124, 58, 237, 0.25)\" \n                    : \"rgba(59, 130, 246, 0.25)\"\n                }\n                className=\"p-6 flex flex-col justify-between h-full\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between border-b border-white/5 pb-4 mb-6\">\n                    <h3 className=\"text-[#a78bfa] font-mono text-xs uppercase tracking-widest\">{category.title}</h3>\n                    <code className=\"text-[10px] text-gray-600 font-mono\">v1.26</code>\n                  </div>\n                  \n                  <div className=\"flex flex-wrap gap-2.5\">\n                    {category.skills.map((skill, sIdx) => (\n                      <span \n                        key={skill} \n                        className=\"px-3.5 py-1.5 bg-white/5 border border-white/10 rounded-xl text-xs font-mono text-gray-300 hover:text-white hover:bg-white/10 hover:border-[#7C3AED]/40 transition-colors duration-200\"\n                      >\n                        {skill}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n                \n                <div className=\"mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-gray-500\">\n                  <span>Stack Coverage</span>\n                  <span className=\"text-[#10B981]\">Production Certified</span>\n                </div>\n              </SpotlightCard>\n            ))}"
      }
