# ==============================================================================
# Portfolio Environment Configuration (.env.example)
# Copy this file to .env and configure your credentials.
# NEVER commit your real .env file with secrets to Git!
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development

# GitHub Integration
# Verified GitHub account username to discover repositories from
GITHUB_USERNAME=Vivek5143

# GitHub Personal Access Token (Optional but Recommended)
# Increases rate limits from 60/hr to 5,000/hr and allows accessing authorized private repositories
# Required token scopes:
# - For public repositories only: public_repo, read:user
# - For private repositories: repo (full control of private repositories)
GITHUB_TOKEN=your_github_pat_token_here

# GitHub Webhook Secret (Required for automated webhook synchronization)
# Set in GitHub repository settings -> Webhooks -> Add webhook -> Secret
# Webhook Payload URL: https://your-domain.com/api/webhooks/github
# Content type: application/json
# Events: Repositories (created, deleted, publicized, privatized, renamed) and Pushes
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Supabase Persistent Backend (Required in production; local JSON storage is for development only)
# Fill these in when connecting to the managed Supabase PostgreSQL instance
# Run the SQL migration in supabase/schema.sql on your Supabase project first
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Admin Authentication & Authorization
ADMIN_USERNAME=admin
# Default dev password is: admin123
# To generate a new bcrypt hash: npx bcryptjs your-password
ADMIN_PASSWORD_HASH=$2a$10$vI8aWBnW3fID.ZQ4/zo1G.q1q3fW40hZ18Z3p88Zq0e5qC8yYjB.S
# JWT Secret for signing admin session tokens
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_random_string

# Frontend Vite Configuration
# Base path for deployment (e.g. './' or '/My-Portfolio/')
VITE_BASE_PATH=./
# API proxy target for Vite dev server
API_TARGET_URL=http://localhost:3001
