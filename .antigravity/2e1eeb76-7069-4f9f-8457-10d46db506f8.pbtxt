      arguments_json: "{\"Instruction\":\"Implement the portfolio structure in App.tsx using the provided design recipe and resume data.\",\"ReplacementContent\":\"import { motion } from \'motion/react\';\\nimport { \\n  Github, \\n  Linkedin, \\n  Mail, \\n  ExternalLink, \\n  Cpu, \\n  ShieldCheck, \\n  Code2, \\n  Terminal,\\n  ChevronRight,\\n  Sparkles\\n} from \'lucide-react\';\\nimport { PROJECTS, EXPERIENCES, SKILLS } from \'./constants\';\\n\\nconst SectionHeader = ({ title, subtitle }: { title: string; subtitle?: string }) => (\\n  <div className=\\\"mb-12\\\">\\n    <motion.h2 \\n      initial={{ opacity: 0, y: 20 }}\\n      whileInView={{ opacity: 1, y: 0 }}\\n      viewport={{ once: true }}\\n      className=\\\"text-3xl md:text-4xl font-bold mb-2 text-gradient\\\"\\n    >\\n      {title}\\n    </motion.h2>\\n    {subtitle && (\\n      <motion.p \\n        initial={{ opacity: 0, y: 10 }}\\n        whileInView={{ opacity: 1, y: 0 }}\\n        viewport={{ once: true }}\\n        transition={{ delay: 0.1 }}\\n        className=\\\"text-gray-400 font-mono text-sm uppercase tracking-widest\\\"\\n      >\\n        {subtitle}\\n      </motion.p>\\n    )}\\n  </div>\\n);\\n\\nexport default function App() {\\n  return (\\n    <div className=\\\"min-h-screen selection:bg-cyber-accent selection:text-cyber-black\\\">\\n      {/* Navigation */}\\n      <nav className=\\\"fixed top-0 w-full z-50 border-b border-white/5 bg-cyber-black/80 backdrop-blur-xl\\\">\\n        <div className=\\\"max-w-7xl mx-auto px-6 h-16 flex items-center justify-between\\\">\\n          <span className=\\\"font-mono font-bold text-cyber-accent tracking-tighter text-xl\\\">VD.AI</span>\\n          <div className=\\\"hidden md:flex gap-8 text-sm font-medium text-gray-400\\\">\\n            <a href=\\\"#about\\\" className=\\\"hover:text-cyber-accent transition-colors\\\">About</a>\\n            <a href=\\\"#skills\\\" className=\\\"hover:text-cyber-accent transition-colors\\\">Skills</a>\\n            <a href=\\\"#projects\\\" className=\\\"hover:text-cyber-accent transition-colors\\\">Works</a>\\n            <a href=\\\"#experience\\\" className=\\\"hover:text-cyber-accent transition-colors\\\">Experience</a>\\n          </div>\\n          <a \\n            href=\\\"mailto:vivekdalvi5143@gmail.com\\\"\\n            className=\\\"px-4 py-2 rounded-full border border-cyber-accent/30 text-cyber-accent text-sm hover:bg-cyber-accent/10 transition-all\\\"\\n          >\\n            Get in touch\\n          </a>\\n        </div>\\n      </nav>\\n\\n      <main className=\\\"max-w-7xl mx-auto px-6 pt-32 pb-20\\\">\\n        {/* Hero Section */}\\n        <section className=\\\"min-h-[70vh] flex flex-col justify-center mb-32\\\">\\n          <motion.div\\n            initial={{ opacity: 0, y: 30 }}\\n            animate={{ opacity: 1, y: 0 }}\\n            transition={{ duration: 0.6 }}\\n          >\\n            <div className=\\\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyber-accent/10 border border-cyber-accent/20 text-cyber-accent text-xs font-mono mb-6\\\">\\n              <Sparkles size={12} />\\n              <span>Available for AI Engineering Roles</span>\\n            </div>\\n            <h1 className=\\\"text-6xl md:text-8xl font-bold tracking-tighter leading-[0.9] mb-8\\\">\\n              Vivek Dalvi <br />\\n              <span className=\\\"text-gradient\\\">Agentic AI & Full-Stack.</span>\\n            </h1>\\n            <p className=\\\"text-xl text-gray-400 max-w-2xl mb-10 leading-relaxed\\\">\\n              Computer Science student specializing in AI & ML. Building production-grade \\n              Agentic AI systems, RAG pipelines, and secure LLM-powered applications.\\n            </p>\\n            <div className=\\\"flex gap-4\\\">\\n              <a \\n                href=\\\"#projects\\\" \\n                className=\\\"px-8 py-4 bg-cyber-accent text-cyber-black font-bold rounded-xl hover:scale-105 transition-transform flex items-center gap-2\\\"\\n              >\\n                View Selected Works <ChevronRight size={18} />\\n              </a>\\n              <div className=\\\"flex gap-2\\\">\\n                <a href=\\\"https://github.com/Vivek5143\\\" className=\\\"p-4 glass-card hover:bg-white/10 transition-colors\\\">\\n                  <Github size={20} />\\n                </a>\\n                <a href=\\\"https://linkedin.com/in/vivek-dalvi5143\\\" className=\\\"p-4 glass-card hover:bg-white/10 transition-colors\\\">\\n                  <Linkedin size={20} />\\n                </a>\\n              </div>\\n            </div>\\n          </motion.div>\\n        </section>\\n\\n        {/* About Section */}\\n        <section id=\\\"about\\\" className=\\\"mb-32\\\">\\n          <SectionHeader title=\\\"The Synthesis\\\" subtitle=\\\"About Me\\\" />\\n          <div className=\\\"grid md:grid-cols-2 gap-12 items-center\\\">\\n            <div className=\\\"space-y-6 text-gray-400 text-lg leading-relaxed\\\">\\n              <p>\\n                Currently pursuing B.E. in Computer Science (AI & ML) at A.P. Shah Institute of Technology \\n                with an <span className=\\\"text-white font-semibold\\\">8.4 CGPA</span>. My academic journey is \\n                complemented by Honors in <span className=\\\"text-white font-semibold\\\">Cyber Security</span>, \\n                giving me a unique perspective on building safe and robust AI.\\n              </p>\\n              <p>\\n                I bridge the gap between natural language and complex media, whether it\'s generating \\n                mathematical animations or building hallucination-resistant RAG systems. My passion lies \\n                in solving real-world problems through intelligent automation.\\n              </p>\\n            </div>\\n            <div className=\\\"grid grid-cols-2 gap-4\\\">\\n              <div className=\\\"glass-card p-6 flex flex-col justify-between aspect-square\\\">\\n                <Cpu className=\\\"text-cyber-accent mb-4\\\" size={32} />\\n                <div>\\n                  <h3 className=\\\"text-xl font-bold text-white\\\">AI Specialist</h3>\\n                  <p className=\\\"text-sm text-gray-500\\\">Agentic AI & RAG</p>\\n                </div>\\n              </div>\\n              <div className=\\\"glass-card p-6 flex flex-col justify-between aspect-square\\\">\\n                <ShieldCheck className=\\\"text-cyber-accent mb-4\\\" size={32} />\\n                <div>\\n                  <h3 className=\\\"text-xl font-bold text-white\\\">Engineer</h3>\\n                  <p className=\\\"text-sm text-gray-500\\\">PII & Encryption</p>\\n                </div>\\n              </div>\\n            </div>\\n          </div>\\n        </section>\\n\\n        {/* Skills Bento Box */}\\n        <section id=\\\"skills\\\" className=\\\"mb-32\\\">\\n          <SectionHeader title=\\\"Technical Bento Box\\\" subtitle=\\\"Stack\\\" />\\n          <div className=\\\"grid md:grid-cols-3 gap-6\\\">\\n            {SKILLS.map((category, idx) => (\\n              <motion.div \\n                key={category.title}\\n                initial={{ opacity: 0, scale: 0.95 }}\\n                whileInView={{ opacity: 1, scale: 1 }}\\n                viewport={{ once: true }}\\n                transition={{ delay: idx * 0.1 }}\\n                className=\\\"glass-card p-8\\\"\\n              >\\n                <h3 className=\\\"text-cyber-accent font-mono text-xs uppercase tracking-widest mb-6\\\">{category.title}</h3>\\n                <div className=\\\"flex flex-wrap gap-2\\\">\\n                  {category.skills.map(skill => (\\n                    <span key={skill} className=\\\"px-3 py-1 bg-white/5 border border-white/10 rounded-full text-sm text-gray-300\\\">\\n                      {skill}\\n                    </span>\\n                  ))}\\n                </div>\\n              </motion.div>\\n            ))}\\n          </div>\\n        </section>\\n\\n        {/* Projects Section */}\\n        <section id=\\\"projects\\\" className=\\\"mb-32\\\">\\n          <SectionHeader title=\\\"Selected Works\\\" subtitle=\\\"Deep Dive\\\" />\\n          <div className=\\\"grid gap-12\\\">\\n            {PROJECTS.map((project, idx) => (\\n              <motion.div \\n                key={project.title}\\n                initial={{ opacity: 0, y: 40 }}\\n                whileInView={{ opacity: 1, y: 0 }}\\n                viewport={{ once: true }}\\n                className=\\\"group relative grid md:grid-cols-2 gap-8 items-start\\\"\\n              >\\n                <div className=\\\"glass-card overflow-hidden aspect-video relative\\\">\\n                  <div className=\\\"absolute inset-0 bg-gradient-to-br from-cyber-accent/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity\\\" />\\n                  <div className=\\\"absolute inset-0 flex items-center justify-center\\\">\\n                    <Terminal className=\\\"text-cyber-accent/20\\\" size={120} />\\n                  </div>\\n                </div>\\n                <div className=\\\"py-4\\\">\\n                  <div className=\\\"flex items-center gap-3 mb-4\\\">\\n                    <h3 className=\\\"text-3xl font-bold text-white\\\">{project.title}</h3>\\n                    <a href=\\\"#\\\" className=\\\"text-gray-500 hover:text-cyber-accent transition-colors\\\">\\n                      <ExternalLink size={20} />\\n                    </a>\\n                  </div>\\n                  <p className=\\\"text-gray-400 mb-6 text-lg\\\">{project.description}</p>\\n                  <div className=\\\"space-y-3 mb-8\\\">\\n                    {project.highlights.map((highlight, hIdx) => (\\n                      <div key={hIdx} className=\\\"flex gap-3 text-sm text-gray-300\\\">\\n                        <ChevronRight size={16} className=\\\"text-cyber-accent shrink-0 mt-1\\\" />\\n                        <span>{highlight}</span>\\n                      </div>\\n                    ))}\\n                  </div>\\n                  <div className=\\\"flex flex-wrap gap-2\\\">\\n                    {project.technologies.map(tech => (\\n                      <span key={tech} className=\\\"text-[10px] font-mono uppercase tracking-tighter px-2 py-1 bg-cyber-accent/10 text-cyber-accent border border-cyber-accent/20 rounded\\\">\\n                        {tech}\\n                      </span>\\n                    ))}\\n                  </div>\\n                </div>\\n              </motion.div>\\n            ))}\\n          </div>\\n        </section>\\n\\n        {/* Experience Section */}\\n        <section id=\\\"experience\\\" className=\\\"mb-32\\\">\\n          <SectionHeader title=\\\"The Journey\\\" subtitle=\\\"Experience\\\" />\\n          <div className=\\\"space-y-12\\\">\\n            {EXPERIENCES.map((exp) => (\\n              <div key={exp.company} className=\\\"relative pl-8 border-l border-white/10\\\">\\n                <div className=\\\"absolute left-[-5px] top-0 w-2 h-2 rounded-full bg-cyber-accent shadow-[0_0_10px_#00ff9d]\\\" />\\n                <div className=\\\"flex flex-col md:flex-row md:items-center justify-between mb-4\\\">\\n                  <div>\\n                    <h3 className=\\\"text-2xl font-bold text-white\\\">{exp.company}</h3>\\n                    <p className=\\\"text-cyber-accent font-mono text-sm\\\">{exp.role}</p>\\n                  </div>\\n                  <div className=\\\"text-right mt-2 md:mt-0\\\">\\n                    <p className=\\\"text-gray-400 text-sm\\\">{exp.period}</p>\\n                    <p className=\\\"text-gray-500 text-xs\\\">{exp.location}</p>\\n                  </div>\\n                </div>\\n                <div className=\\\"space-y-2 max-w-3xl\\\">\\n                  {exp.highlights.map((h, i) => (\\n                    <p key={i} className=\\\"text-gray-400 leading-relaxed\\\">\342\200\242 {h}</p>\\n                  ))}\\n                </div>\\n              </div>\\n            ))}\\n          </div>\\n        </section>\\n      </main>\\n\\n      {/* Footer */}\\n      <footer className=\\\"border-t border-white/5 py-12\\\">\\n        <div className=\\\"max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-8\\\">\\n          <div>\\n            <span className=\\\"font-mono font-bold text-cyber-accent tracking-tighter text-2xl mb-2 block\\\">VD.AI</span>\\n            <p className=\\\"text-gray-500 text-sm\\\">\302\251 2026 Vivek Dalvi. Built with AI Studio.</p>\\n          </div>\\n          <div className=\\\"flex gap-6\\\">\\n            <a href=\\\"https://github.com/Vivek5143\\\" className=\\\"text-gray-400 hover:text-cyber-accent transition-colors flex items-center gap-2\\\">\\n              <Github size={18} /> GitHub\\n            </a>\\n            <a href=\\\"https://linkedin.com/in/vivek-dalvi5143\\\" className=\\\"text-gray-400 hover:text-cyber-accent transition-colors flex items-center gap-2\\\">\\n              <Linkedin size={18} /> LinkedIn\\n            </a>\\n            <a href=\\\"mailto:vivekdalvi5143@gmail.com\\\" className=\\\"text-gray-400 hover:text-cyber-accent transition-colors flex items-center gap-2\\\">\\n              <Mail size={18} /> Email\\n            </a>\\n          </div>\\n        </div>\\n      </footer>\\n    </div>\\n  );\\n}\",\"TargetContent\":\"/**\\n * @license\\n * SPDX-License-Identifier: Apache-2.0\\n */\\n\\nexport default function App() {\\n  return <div></div>;\\n}\",\"TargetFile\":\"/src/App.tsx\"}"
