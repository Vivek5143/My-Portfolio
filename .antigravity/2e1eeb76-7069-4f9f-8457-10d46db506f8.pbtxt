        lines {
          text: "function CampusPalWidget() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [messages, setMessages] = useState<Array<{ sender: \'user\' | \'ai\'; text: string; sources?: string[] }>>(["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    { sender: \'user\', text: \"What are the placement opportunities at APSIT?\" },"
