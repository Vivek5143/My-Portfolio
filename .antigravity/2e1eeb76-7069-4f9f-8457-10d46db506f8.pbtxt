I\' && <TransactAIWidget />}\n                      {project.title === \'InstaClaim\' && <InstaClaimWidget />}\n                      {project.title === \'Multi-Agent Platform\' && <MultiAgentWidget />}\n                      {project.title === \'Daily-Work-Logger\' && <WorkLoggerWidget />}\n                      {project.title === \'Interview Assistant\' && <InterviewAssistantWidget />}\n\n                    </SpotlightCard>\n                  </div>"
