        }
        lines {
          text: "  const [pipelineState, setPipelineState] = useState<\'idle\' | \'routing\' | \'retrieving\' | \'hallucination_check\' | \'typing\'>(\'idle\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const presetQuestions = ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    \"What is the average packages at APSIT?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
