      replacement_content: "            {/* Right side timeline milestones */}\n            <div className=\"lg:col-span-5 flex flex-col justify-center\">\n              <SpotlightCard className=\"p-8 border-white/10 space-y-8 flex-1 flex flex-col justify-around\" glowColor=\"rgba(59, 130, 246, 0.1)\" borderColor=\"rgba(59, 130, 246, 0.2)\">\n                <h3 className=\"font-bold text-white text-xl font-sans border-b border-white/5 pb-4\">Key Achievements & Education</h3>\n                \n                <div className=\"space-y-6\">\n                  <div className=\"flex gap-4\">\n                    <div className=\"shrink-0 w-8 h-8 rounded-full bg-[#7C3AED]/20 border border-[#7C3AED]/30 flex items-center justify-center text-[#a78bfa] font-mono text-xs font-bold\">\n                      01\n                    </div>\n                    <div>\n                      <h4 className=\"font-semibold text-white text-base\">A.P. Shah Institute of Technology</h4>\n                      <p className=\"text-xs text-gray-400 font-mono\">B.E. Computer Engineering (AI & ML) \342\200\242 Graduated</p>\n                      <p className=\"text-sm text-slate-300 mt-1 font-mono\">GPA: <span className=\"text-[#10B981] font-bold\">8.4 / 10</span></p>\n                    </div>\n                  </div>\n\n                  <div className=\"flex gap-4\">\n                    <div className=\"shrink-0 w-8 h-8 rounded-full bg-[#3B82F6]/20 border border-[#3B82F6]/30 flex items-center justify-center text-[#60a5fa] font-mono text-xs font-bold\">\n                      02\n                    </div>\n                    <div>\n                      <h4 className=\"font-semibold text-white text-base\">Cyber Security Honors degree</h4>\n                      <p className=\"text-xs text-gray-400 font-mono\">AP Shah Institute \342\200\242 Specialised Track</p>\n                      <p className=\"text-sm text-slate-300 mt-1\">Acquired detailed expertise in cryptographic models, PI